    W[Business website / mobile app] 
    AD[Admin dashboard - React]
  end
  subgraph APIL[API layer - FastAPI]
    I["Integration API /api/v1<br/>(API key + session token)"]
    AA["Admin API /api/admin<br/>(signed admin token)"]
  end
