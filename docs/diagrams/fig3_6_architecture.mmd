    PE[Deterministic policy engine]
    HE[Handoff engine]
  end
  subgraph Biz[Business integration layer]
    T[Action registry<br/>least-privilege allowlist]
    BA[Business API - orders]
  end
  DB[(Database:<br/>sessions, conversations,<br/>audit logs, handoffs)]
  G[[Google Gemini API]]
  W --> I --> O
  AD --> AA --> DB
  O --> SG
