# Copy this file to backend/.env (gitignored); the API loads it on start. Real environment variables win.
# AI models: set either key or both. Groq answers first (LLM_ORDER), Gemini is the backup.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_ORDER=groq,gemini
APP_SECRET=
ALLOW_PRIVATE_WEBHOOK_URLS=1
# WhatsApp Cloud API (Meta). Leave empty to disable the WhatsApp channel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
